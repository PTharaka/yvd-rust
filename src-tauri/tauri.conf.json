{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YouTube Downloader Pro",
  "version": "0.1.0",
  "identifier": "com.yvd.downloader",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "YouTube Downloader Pro",
        "width": 960,
        "height": 720,
        "minWidth": 780,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/PTharaka/yvd-rust/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
